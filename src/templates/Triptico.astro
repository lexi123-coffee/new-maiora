---
import MenuItem from "../components/MenuItem.astro";
import MenuItemRight from "../components/MenuItemRight.astro";

const {
  tituloIzquierda,
  precioIzquierda,
  imagenIzquierda,
  tituloDerecha,
  precioDerecha,
  imagenDerecha,
  centro,
} = Astro.props;
---

<div class="grid-item">
  <div class="left-box">
    <MenuItem
      title={tituloIzquierda}
      price={precioIzquierda}
      image={imagenIzquierda}
    />
  </div>
</div>

<div class="grid-item item-teal">
  <div class="top-content">
    <h2>{centro?.title || "Especialidad"}</h2>

    <ul>
      <li>
        <span>{centro?.sub_item_title || "Ven y disfruta..."}</span>
        <span>{centro?.sub_item_price || "$75"}</span>
      </li>
    </ul>
  </div>

  <div class="mid-image logo-container">
    <div class="logo-wrapper">
      <img
        src="/images/remove.png"
        alt="Maiora logo"
        class="masked-logo"
      />
    </div>
  </div>

  <div class="bottom-content">
    <ul>
      {centro?.rows?.map((row) => (
        <li>
          <span>{row.title}</span>
          <b>{row.price}</b>
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="grid-item">
  <div class="right-box">
    <MenuItemRight
      title={tituloDerecha}
      price={precioDerecha}
      image={imagenDerecha}
    />
  </div>
</div>

<style>
:global(.left-box),
:global(.right-box) {
    flex: 1;
    display: flex;
}

:global(.left-box > *),
:global(.right-box > *) {
    flex: 1;
}

.grid-item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
}

.grid-item:nth-child(1)::after,
.grid-item:nth-child(2)::after {
    content: "";
    position: absolute;
    top: 4%;
    right: -1px;
    width: 7px;
    height: 92%;
    border-radius: 999px;

    background: linear-gradient(
        to bottom,
        rgba(197,160,89,.4),
        rgba(197,160,89,.9),
        rgba(197,160,89,.9),
        transparent
    );

    box-shadow:
        0 0 8px rgba(197,160,89,.35),
        0 0 18px rgba(197,160,89,.25),
        0 0 30px rgba(197,160,89,.15);

    z-index: 10;

    animation: goldGlow 5s ease-in-out infinite;
}

.item-teal {
    display: grid;
    grid-template-rows: auto auto auto;
    justify-content: center;
    background: #171313;
    color: white;
    height: 100%;
    padding: 1vh 0.5vw;
}

.top-content,
.bottom-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1vw 0.5vw;
}

.bottom-content {
    margin-top: -110px;
}

.logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    transform: translateY(-40px);
}

.logo-wrapper {
    padding: 3vh;
    border-radius: 16px;
    background: radial-gradient(circle, rgba(255,255,255,.25), transparent 70%);
}

.masked-logo {
    width: 100%;
    max-height: 23vh;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    filter:
      drop-shadow(0 0 10px rgba(255,255,255,.6))
      drop-shadow(0 0 20px rgba(200,200,200,.4));
}

h2 {
    font-size: 1.5vw;
    text-align: center;
    line-height: 1.2;
    color: #C5A059;
}

li {
    display: flex;
    justify-content: space-between;
    font-size: 1.5vw;
    border-bottom: 1px solid rgba(197,160,89,.2);
    padding: .5vh .2vw;
    color: #E5D7C3;
}

img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
</style>
