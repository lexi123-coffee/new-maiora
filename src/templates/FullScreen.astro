---
const {
  imagen,
  titulo,
  descripcion = [],
} = Astro.props;
---

<div class="fullscreen-slide">

  <div class="image-box">
    <img src={imagen} alt={titulo} />
  </div>

  <div class="info-box">

    <h1>{titulo}</h1>

    <ul>
      {descripcion.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

  </div>

</div>

<style>

.fullscreen-slide{
    width:100%;
    height:100%;

    font-family:'Montserrat', Arial, sans-serif;

    display:flex;
    flex-direction:row;

    justify-content:center;
    align-items:center;

    gap: 5vw;

    padding:3vh 5vw;

    box-sizing:border-box;

    background:#171313;
}

/* Imagen */

.image-box{

    width:55%;
    aspect-ratio:1 / 1;

    border-radius:22px;

    overflow:hidden;

    border:4px solid rgba(197,160,89,.45);

    box-shadow:
        0 22px 55px rgba(0,0,0,.75),
        0 0 35px rgba(197,160,89,.65),
        0 0 70px rgba(197,160,89,.45);
}

.image-box img{

    width:100%;
    height:100%;

    object-fit:cover;

    filter:
      brightness(1.15)
      contrast(1.1)
      saturate(1.15);
}

/* Texto */

.info-box{

    width:35%;

    text-align:left;
}

.info-box h1{

    color:#C5A059;

    font-family:'Cinzel', serif;

    font-weight:700;

    font-size:4vw;

    margin-bottom:3vh;

    letter-spacing:3px;

    text-transform:uppercase;
}

.info-box ul{

    list-style:none;

    padding:0;

    margin:0;
}

.info-box li{

    color:#E5D7C3;

    font-size:2.4vw;

    margin-bottom:2vh;

    line-height:1.8;
}

.info-box li::before{

    content:"✓ ";

    color:#C5A059;

    font-weight:bold;
}

/* ========================================
   ENTRADA ELEGANTE DEL FULLSCREEN
   Optimizada para Smart TV
======================================== */

/* La fotografía entra muy suavemente */
:global(.menu-page.active) .image-box {
    animation: fullscreenImageIn 1.2s ease-out both;
}

/* Título */
:global(.menu-page.active) .info-box h1 {
    animation: fullscreenTextIn 1s ease-out 0.15s both;
}

/* Descripciones */
:global(.menu-page.active) .info-box li {
    animation: fullscreenTextIn 1s ease-out both;
}

/* Entrada escalonada */
.info-box li:nth-child(1) {
    animation-delay: 0.30s;
}

.info-box li:nth-child(2) {
    animation-delay: 0.45s;
}

.info-box li:nth-child(3) {
    animation-delay: 0.60s;
}

.info-box li:nth-child(4) {
    animation-delay: 0.75s;
}


/* FOTO:
   desplazamiento mínimo + aparición */
@keyframes fullscreenImageIn {
    from {
        opacity: 0;
        transform: translate3d(-12px, 0, 0);
    }

    to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
}


/* TEXTO:
   entra desde la derecha hacia su posición actual */
@keyframes fullscreenTextIn {
    from {
        opacity: 0;
        transform: translate3d(18px, 0, 0);
    }

    to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
}


/* Accesibilidad */
@media (prefers-reduced-motion: reduce) {
    .image-box,
    .info-box h1,
    .info-box li {
        animation: none;
    }
}

</style>


