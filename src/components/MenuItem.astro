---
interface Props {
    title: string;
    price: string;
    image: string;
}

const { title, price, image } = Astro.props;
---

<article class="menu-item">
    <div class="photo-container">
        <img src={image} alt={title} />
    </div>
    <div class="info-container">
        <div class="text-wrapper">
            <h2 set:html={title} />
            <div class="price-badge">
                <span class="price-value">{price}</span>
            </div>
        </div>
    </div>
</article>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Montserrat:wght@300;600&display=swap');

    .menu-item {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        background: transparent;
        overflow: hidden;
        transition: transform 0.35s ease, box-shadow 0.35s ease;

    }

    .photo-container {
        width: 100%;
        height: 60%;
        box-shadow: none;
        position: relative;
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        animation: kenburns 25s infinite alternate ease-in-out;
    }

    .info-container {
        width: 100%;
        height: 40%;
        background: linear-gradient(135deg, #7a6237, #b89b63, #8f7546);
        display: flex;
		margin-top: 0;
		flex-direction: column;
		justify-content: center;
        align-items: center;
        padding: 4vh 2vw;
        position: relative;
        overflow: hidden;
    }

    .info-container::after {
        content: "";
        position: absolute;
        top: -50%;
        left: -60%;
        width: 20%;
        height: 200%;
        background: rgba(255, 255, 255, 0.2);
        transform: rotate(30deg);
        transition: all 0.7s;
        animation: reflection 5s infinite;
    }

    .text-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        width: 100%;
    }

    h2 {
       font-family: 'Cinzel', serif;
       font-size: clamp(1.4rem, 2.5vw, 2.8rem);
       color: #000;
       text-transform: uppercase;
       letter-spacing: 1.5px;
       line-height: 1.2;
       text-align: center;
       max-width: 90%;
       margin: 0;
       word-wrap: break-word;
    }

    h2 :global(small) {
     font-family: 'Montserrat', sans-serif;
     font-size: 0.65em;
     color: #000000;
     font-weight: 600;
     display: block;
     margin-top: 0.5rem;
     opacity: 1;
     text-transform: none;
     text-shadow: 0px 1px 1px rgba(255, 255, 255, 0.3);
    }

     .price-badge {
       background-color: rgba(0, 0, 0, 0.6);
       backdrop-filter: blur(12px);
       -webkit-backdrop-filter: blur(12px);
       border: 1px solid rgba(212, 175, 55, 0.4);
       width: fit-content;
       min-width: 8vw;
       padding: 0 2vw;
       height: 10vh;
       border-radius: 8px;
       display: flex;
       justify-content: center;
       align-items: center;
       margin: 0 auto;
       box-shadow: 0 8px 32px rgba(0,0,0,0.8);
       overflow: hidden;
    }

    .price-badge:hover {
       transform: translateY(-2px);
       box-shadow: 0 12px 25px rgba(0, 0, 0, 0.35);
    }

    .price-value {
       font-family: 'Montserrat', sans-serif;
       color: #fff;
       font-size: 3vw;
       font-weight: 700;
       line-height: 1;
       margin: 0;
       padding: 0;
       letter-spacing: -1px;
    }

    @keyframes entradaDesdeIzquierda {
        from {
            opacity: 0;
            transform: translateX(-100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes reflection {
        0% { left: -60% }
        20% { left: 120% }
        100% { left: 120% }
    }

</style>
