---
interface Props {
    title: string;
    price: string;
    image: string;
}

const { title, price, image } = Astro.props;
const hasPrice = price !== undefined && price !== null && price !== '';
---

<article class="menu-item">
    <div class="info-container">
        <div class="text-wrapper">
            <h2 set:html={title} />
            { hasPrice &&
              <div class="price-badge">
                  <span class="price-value">{price}</span>
              </div>
            }
        </div>
    </div>

    <div class="photo-container">
        <img src={image} alt={title} />
    </div>

</article>

<style>
    .menu-item {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    /* PARTE SUPERIOR */
    .info-container {
      height: 38%;
      background: linear-gradient(135deg, #7a6237, #b89b63, #8f7546);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2vh 1vw;
      text-align: center;
    }

    /* TEXTO */
    h2 {
      font-family: 'Cinzel', serif;
      font-size: 1.8vw;
      color: #000;
      text-transform: uppercase;
      line-height: 1.2;
      margin: 0;
    }

    h2 :global(small) {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6em;
        display: block;
        margin-top: 0.5rem;
    }

    /* PRECIO */
    .price-badge {
      margin-top: 1vh;
      background: #000;
      padding: 0.5vh 1.5vw;
      border-radius: 4px;
    }

    .price-value {
      color: #fff;
      font-size: 1.8vw;
      font-weight: bold;
    }

   /* IMAGEN */
   .photo-container {
        height: 62%;
    }

    .photo-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

</style>
