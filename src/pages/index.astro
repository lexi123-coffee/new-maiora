---
import Layout from '../layouts/Layout.astro';
import MenuItem from '../components/MenuItem.astro';
import MenuItemRight from '../components/MenuItemRight.astro';

const secciones = [
    {
    tituloIzquierda: "Huevos al gusto <br/> <small>(frijoles, chilaquiles)</small>",
    precioIzquierda: "$30",
    imagenIzquierda: "/images/chilaquiles.jpg",
    tituloDerecha: "Rollos de Sushi",
    precioDerecha: "$45",
    imagenDerecha: "/images/Sushi.jpg"
  },

  {
    tituloIzquierda: "Sección 2 - Platillo A",
    precioIzquierda: "$100",
    imagenIzquierda: "/images/ensalada.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$120",
    imagenDerecha: "/images/mix.jpg"
  },

  {
    tituloIzquierda: "Sección 3 - Platillo A",
    precioIzquierda: "$110",
    imagenIzquierda: "/images/nopal.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$90",
    imagenDerecha: "/images/nuggets.jpg"
  },

  {
    tituloIzquierda: "Sección 4 - Platillo A",
    precioIzquierda: "$85",
    imagenIzquierda: "/images/pechuga.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$95",
    imagenDerecha: "/images/frito.jpg"
  },

   {
    tituloIzquierda: "Sección 5 - Platillo A",
    precioIzquierda: "$75",
    imagenIzquierda: "/images/torta.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$85",
    imagenDerecha: "/images/saludable.jpg"
  },

  {
    tituloIzquierda: "Sección 6 - Platillo A",
    precioIzquierda: "$100",
    imagenIzquierda: "/images/asada.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$95",
    imagenDerecha: "/images/jitomate.jpg"
  },

  {
    tituloIzquierda: "Sección 7 - Platillo A",
    precioIzquierda: "$100",
    imagenIzquierda: "/images/risa.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$95",
    imagenDerecha: "/images/guacamole.jpg"
  },

  {
    tituloIzquierda: "Sección 8 - Platillo A",
    precioIzquierda: "$35",
    imagenIzquierda: "/images/dulces.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$55",
    imagenDerecha: "/images/si.jpg"
  },

  {
    tituloIzquierda: "Sección 9 - Platillo A",
    precioIzquierda: "$35",
    imagenIzquierda: "/images/crepa.jpg",
    tituloDerecha: "Sección 2 - Platillo B",
    precioDerecha: "$55",
    imagenDerecha: "/images/pizza.jpg"
  },

]
---

<Layout title="Menú Digital Maiora">
  <main class="menu-slider">
       {secciones.map((sec, index) => (
           <div class={`menu-page ${index === 0 ? 'active' : ''}`}>
              <div class="grid-item">
                   <div class="left-box">
                       <MenuItem
                         title={sec.tituloIzquierda}
                         price={sec.precioIzquierda}
                         image={sec.imagenIzquierda}
                       />
                   </div>
              </div>

              <div class="linea linea-left"></div>
                <div class="grid-item item-teal">
                    <div class="top-content">
                       <h2>Especialidad de la casa</h2>
                        <ul>
                           <li><span>Ven y disfruta de nuestros ricos platillos desde:</span> <span>$50</span></li>
                        </ul>
                   </div>

                   <div class="mid-image logo-container">
                       <div class="logo-wrapper">
                            <img src="/images/logo.jpg" alt="Maiora logo" class="masked-logo" />
                      </div>
                  </div>
                   <div class="bottom-content">
                       <ul>
                           <li><span><b>Ingredientes extra:</b></span> <span>$15</span></li>
                           <li><span>Bebidas desde:</span> <span>$45</span></li>
                       </ul>
                   </div>
                </div>

               <div class="linea linea-right"></div>
               <div class="grid-item">
                   <div class="right-box">
                       <MenuItemRight
                          title={sec.tituloDerecha}
                          price={sec.precioDerecha}
                          image={sec.imagenDerecha}
                        />
                   </div>
               </div>
           </div>
        ))}
    </main>
</Layout>

<style>
    .menu-slider {
        position: relative;
        width: 100vw;
        height: 100vh;
        background-color: #000;
        overflow: hidden;
    }

    .menu-page {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.5s ease-in-out;
    }

    .menu-page.active {
        opacity: 1;
        visibility: visible;
        z-index: 10;
    }

    .grid-item {
        position: relative;
        box-sizing: border-box;
        border: 0.5px solid rgba(197, 160, 89, 0.25);
        box-shadow:
             inset 0 0 20px rgba(0, 0, 0, 0.6),
             inset 0 0 60px rgba(0, 0, 0, 0.4);
        overflow: hidden;
    }

    .active .grid-item:first-child {
        animation: entradaDesdeIzquierda 1.2s ease-out forwards;
    }

    .active .logo-wrapper {
      animation:
        entradaDesdeArriba 1.2s ease-out forwards,
        pulsoSuave 5s ease-in-out 1.2s infinite;
    }

    .active .top-content,
    .active .bottom-content {
        animation: entradaDesdeArriba 1.2s ease-out forwards;
    }

    @keyframes entradaDesdeIzquierda {
        from {
            opacity: 0;
            transform: translateX(-100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .item-teal {
        background-color: #171313;
        color: white;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background-image: url("https://www.transparenttextures.com/patterns/dark-leather.png");
        color: white;
        padding: 0 !important;
        margin: 0 !important;
        animation: flotar 8s ease-in-out infinite;
    }

    .top-content, .bottom-content {
        height: 22%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2vw 4vw;
    }

    .logo-container {
        height: 56%;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .logo-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
      width: 100%;
      filter: drop-shadow(0px 0px 3vw rgba(224, 183, 107, 0.7));
      animation:
        entradaDesdeArriba 1.2s ease-out forwards,
        pulsoSuave 5s ease-in-out 1.2s infinite;
    }

    @keyframes pulsoSuave {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0px 0px 20px rgba(224, 183, 107, 0.6));
        }
        50% {
            transform: scale(1.08);
            filter: drop-shadow(0px 0px 50px rgba(224, 183, 107, 1));
        }
    }

    .masked-logo {
        position: relative;
        height: 90%;
        width: auto;
        max-width: 95%;
        display: block;
        object-fit: contain;

        -webkit-mask-image: radial-gradient(circle, black 69%, transparent 70%);
        mask-image: radial-gradient(circle, black 69%, transparent 70%);
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
    }

    h2 {
        font-family: 'Cinzel', serif;
        font-size: 2.5vw;
        margin-bottom: 1vh;
        color: #C5A059;
        text-transform: uppercase;
    }

    ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    li {
        display: flex;
        justify-content: space-between;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-size: 1.2vw;
        font-weight: 400;
        border-bottom: 1px solid rgba(197, 160, 89, 0.2);
        padding: 2vh 0;
        margin-bottom: 0;
    }

    li b {
        color: #C5A059
    }

    @keyframes entradaDesdeArriba {
        from {
            opacity: 0;
            transform: translateY(-100%);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .linea {
        position: absolute;
        top: -160px;
        width: 8px;
        height: 160px;
        background: linear-gradient(
            to bottom,
            transparent,
            #d4af37,
            transparent
        );
        box-shadow:
          0 0 12px rgba(212, 175, 55, .9),
          0 0 25px rgba(212, 175, 55, .8),
          0 0 45px rgba(212, 175, 55, .6);
        animation: getdown 6s linear infinite;
        z-index: 10;
    }

    .linea-left{
        left: calc(33.33% - 4px);

    }

    .linea-right {
        left: calc(66.66% - 4px);
    }

    .active .grid-item:last-child {
       animation: entradaDesdeDerecha 1.2s ease-out forwards;
    }

    @keyframes getdown {
        from {
            top: -160px;
        }
        to {
            top: 100%;
        }
    }

    @keyframes flotar {
       0%,100% {
          transform: translateY(0px);
        }
       50% {
          transform: translateY(-3px);
        }
    }

    @keyframes watchme {
       0%, 100% {
         transform: scale(1) translateY(-6px);
         filter: drop-shadow(0 0 5px rgba(0, 0, 0, 0.5));
        }
      25%, 75% {
         transform: scale(1.12) translateY(-6px);
         filter: drop-shadow(0 0 25px rgba(197, 160, 89, 1));
        }
    }

    @keyframes entradaDesdeDerecha {
       from {
          opacity: 0;
          transform: translateX(100%);
        }
        to {
           opacity: 1;
           transform: translateX(0);
        }
    }

   :global(.left-box), :global(.right-box) {
      height: 100vh;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 0;
      margin: 0;
      box-sizing: border-box;
      position: relative;
    }

    :global(.left-box [class*="price"]),
    :global(.left-box b),
    :global(.right-box [class*="price"]),
    :global(.right-box b) {
      display: inline-block;
      margin-top: 1.5rem;
      margin-bottom: 2rem !important;
      animation: watchme 8s ease-in-out infinite;
    }

    :global(.right-box [class*="price"]),
    :global(.right-box b) {
      animation-delay: 4s;
    }

    :global(.left-box img), :global(.right-box img) {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      display: block;
      margin: 0;
    }

</style> <script>
    const slides = document.querySelectorAll('.menu-page');
    let currentSlide = 0;

    function rotateMenu() {
        slides[currentSlide].classList.remove('active');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide].classList.add('active');
    }

    setInterval(rotateMenu, 10000);

</script>
